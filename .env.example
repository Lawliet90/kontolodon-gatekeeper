# Copy to .env and fill in real values. NEVER commit .env.
# HMAC secret shown exactly once when the agent is created on the dashboard.
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key (https://kurier.xyz) — needs email verification first.
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
PORT=8787
# Set to true to attach raw proof + public_signals to task responses (test in practice first).
INCLUDE_PROOF_FIELDS=false
